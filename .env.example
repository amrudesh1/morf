# MORF environment configuration.
#
# Copy this file to `.env` (which is gitignored) and set real values. The
# docker-compose stack reads it automatically. Every value below has a
# LOCAL-DEVELOPMENT-only fallback baked into docker-compose.yml, so `docker
# compose up` works without a .env — but any real deployment MUST override the
# credentials here (or use Docker secrets / a secrets manager).

# --- MySQL credentials (mysql service + backend DATABASE_URL) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=morf
MYSQL_USER=morf
MYSQL_PASSWORD=change-me-app

# --- Backend connection strings ---
# If you change MYSQL_USER/MYSQL_PASSWORD above, set DATABASE_URL to match.
DATABASE_URL=morf:change-me-app@tcp(mysql:3306)/morf?charset=utf8mb4&parseTime=True&loc=Local
REDIS_URL=redis://redis:6379

# --- Runtime ---
# Use "release" in real deployments; "debug" only for local development.
MORF_GIN_MODE=release

# --- Security ---
# Mask secret values in the /results JSON API (default true). Set to false ONLY
# in a trusted internal deployment where callers are allowed raw secret values.
MORF_MASK_RESULTS=true
# API-key auth is fail-closed by default (true). Setting it false still leaves
# /results, /secrets, /compare, /jira, /slackscan and pattern-mutation routes
# authenticated (see auth/middleware.go).
MORF_REQUIRE_API_KEY=true
